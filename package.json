{
  "name": "glyphide",
  "type": "module",
  "version": "2.3.0",
  "description": "Write, run, and share JavaScript code instantly",
  "author": "Pedro Carreño (34664891+Pkcarreno@users.noreply.github.com)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "preinstall": "npx only-allow pnpm",
    "commitlint": "commitlint",
    "prepare": "lefthook install",
    "root:knip": "knip",
    "knip": "turbo run //#root:knip --",
    "clean": "turbo run clean",
    "nuke": "pnpm run clean && rm -rf node_modules .turbo pnpm-lock.yaml"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "knip": "^6.24.0",
    "lefthook": "^2.1.4",
    "turbo": "^2.9.1",
    "ultracite": "^7.8.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkcarreno/glyphide.git"
  }
}
