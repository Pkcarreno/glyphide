{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#root:knip": {
      "cache": true,
      "inputs": [
        "knip.json",
        "package.json",
        "**/*.{ts,tsx,mjs,js,jsx}",
        "!legacy/**",
        "!node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**"
      ]
    },
    "format": {
      "outputs": ["node_modules/.cache/.prettiercache"]
    },
    "format:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
