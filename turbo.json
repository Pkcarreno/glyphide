{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#root:knip": {
      "dependsOn": ["^root:knip"]
    },
    "format": {
      "outputs": ["node_modules/.cache/.prettiercache"]
    },
    "format:fix": {
      "cache": false
    },
    "check": {},
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    }
  }
}
