{
  "name": "@glyphide/mock-engine",
  "version": "0.1.0",
  "description": "Mock engine for testing RPC protocol and orchestrator behavior",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./dist/mock-adapter.d.ts",
      "default": "./dist/mock-adapter.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./worker": {
      "types": "./dist/worker/mock-worker.d.ts",
      "default": "./dist/worker/mock-worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glyphide/rpc-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@glyphide/orchestrator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  }
}
