{
  "name": "@glyphide/quickjs-engine",
  "version": "0.1.1",
  "private": true,
  "description": "QuickJS engine adapter for orchestrator",
  "type": "module",
  "exports": {
    "./adapter": {
      "types": "./dist/src/quickjs-adapter.d.mts",
      "default": "./dist/src/quickjs-adapter.mjs"
    },
    "./types": {
      "types": "./dist/src/types.d.mts",
      "default": "./dist/src/types.mjs"
    },
    "./worker": {
      "types": "./dist/worker/quickjs-worker.d.mts",
      "default": "./dist/worker/quickjs-worker.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glyphide/rpc-protocol": "workspace:*",
    "quickjs-emscripten": "^0.32.0"
  },
  "peerDependencies": {
    "@glyphide/orchestrator": "workspace:*"
  },
  "devDependencies": {
    "@glyphide/orchestrator": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
